{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run unit && npm run e2e",
    "unit": "node --test \"unit/**/*.test.mjs\"",
    "e2e": "playwright test --grep-invert @visual",
    "visual": "playwright test --grep @visual",
    "visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
