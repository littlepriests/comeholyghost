/scripts/node_modules/

# Netlify function deps
/node_modules/

# Vale binary + sync cache (reinstall Vale, then `vale sync` / `corn edit`).
# House rules live in styles/wraith/ and DO ship. Do not ignore that folder.
# (Old `Styles/` entry matched styles/ on Windows and hid wraith.)
styles/*
!styles/wraith/
!styles/wraith/**
.vale.ini
.vale/
vale
vale.exe
vale-rules/

# Secrets / credentials (never commit; keep Docker/work auth out)
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
.netrc
.npmrc.local
.docker/
Dockerfile
docker-compose.yml
docker-compose.yaml
docker-compose.*.yml
docker-compose.*.yaml

